{
  "id": "node-workspace",
  "name": "Node Workspace",
  "description": "Keep one durable managed source workspace on a paired node: sync in place, preserve build caches, protect secrets, and fetch selected artifacts back.",
  "categories": [
    "developer-tools"
  ],
  "contracts": {
    "tools": [
      "node_workspace_sync",
      "node_workspace_artifact",
      "node_workspace_status"
    ]
  },
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "gateway": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "localRoots": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional. Narrows a push beyond the session workspace; empty means no additional restriction."
          },
          "artifactRoots": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional. Narrows an artifact destination beyond the session workspace; empty means no additional restriction."
          },
          "maxFiles": {
            "type": "integer",
            "minimum": 1
          },
          "maxFileBytes": {
            "type": "integer",
            "minimum": 1
          },
          "maxTotalBytes": {
            "type": "integer",
            "minimum": 1
          },
          "maxArtifactBytes": {
            "type": "integer",
            "minimum": 1
          },
          "chunkBytes": {
            "type": "integer",
            "minimum": 1024
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1000
          }
        }
      },
      "node": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "pushRoots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "artifactRoots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "maxFiles": {
            "type": "integer",
            "minimum": 1
          },
          "maxFileBytes": {
            "type": "integer",
            "minimum": 1
          },
          "maxTotalBytes": {
            "type": "integer",
            "minimum": 1
          },
          "maxArtifactBytes": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  },
  "controlUi": {
    "entry": "dist/control-ui/9fe0dbb7db35dd3a400b53a2064d4ce789b449afff156e26d4f70aac9c89ffb2/index.js",
    "styles": []
  }
}
