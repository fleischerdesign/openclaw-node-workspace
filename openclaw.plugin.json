{
  "id": "node-workspace",
  "name": "Node Workspace",
  "description": "Publish an explicitly selected workspace from an OpenClaw Gateway to a paired node, incrementally reuse unchanged files, and return changed or generated project files with a preview.",
  "categories": [
    "developer-tools"
  ],
  "contracts": {
    "tools": [
      "node_workspace_push",
      "node_workspace_artifact",
      "node_workspace_status",
      "node_workspace_changes",
      "node_workspace_return"
    ]
  },
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "gateway": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "localRoots": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional. Narrows a push beyond the session workspace; empty means no additional restriction."
          },
          "artifactRoots": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional. Narrows an artifact destination beyond the session workspace; empty means no additional restriction."
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "symlinks": {
            "type": "string",
            "enum": [
              "reject",
              "skip"
            ]
          },
          "maxFiles": {
            "type": "integer",
            "minimum": 1
          },
          "maxFileBytes": {
            "type": "integer",
            "minimum": 1
          },
          "maxTotalBytes": {
            "type": "integer",
            "minimum": 1
          },
          "maxArtifactBytes": {
            "type": "integer",
            "minimum": 1
          },
          "chunkBytes": {
            "type": "integer",
            "minimum": 1024
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1000
          },
          "returnRoots": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional. Narrows a return target beyond the session workspace; empty means no additional restriction."
          }
        }
      },
      "node": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "pushRoots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "artifactRoots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "maxFiles": {
            "type": "integer",
            "minimum": 1
          },
          "maxFileBytes": {
            "type": "integer",
            "minimum": 1
          },
          "maxTotalBytes": {
            "type": "integer",
            "minimum": 1
          },
          "maxArtifactBytes": {
            "type": "integer",
            "minimum": 1
          },
          "returnRoots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "controlUi": {
    "entry": "dist/control-ui/b4fc2c805bde770a0618ac8536992b86534e33b2994903859a80ef9b11b6a680/index.js",
    "styles": []
  }
}
